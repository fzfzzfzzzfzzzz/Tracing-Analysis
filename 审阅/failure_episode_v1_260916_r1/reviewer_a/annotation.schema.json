                        },
                        "type": "array",
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "evidence_ids",
                      "constraints"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "relevant_evidence_ids": {
