                "type": "array",
                "uniqueItems": true
              },
              "type": "array"
            },
            "causal_paths": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "constraints": {
                    "items": {
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 2,
                      "minItems": 2,
                      "type": "array"
                    },
                    "type": "array"
