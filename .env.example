# Model provider keys used by live τ³-bench runs. Set only the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# GLM / Z.AI (China BigModel endpoint). Never put a real key in this example.
ZAI_API_KEY=
ZAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
TRACEGRAPH_AGENT_MODEL=zai/glm-4.7-flash
TRACEGRAPH_USER_MODEL=zai/glm-4.7-flash

# TraceGraph live τ³ context-manager condition.
TRACEGRAPH_MANAGER=full_ours
TRACEGRAPH_BUDGET=16384
TRACEGRAPH_LAST_K=8
TRACEGRAPH_OUTPUT_DIR=outputs/tau3_live

# Optional official ACON external baseline. The source snapshot remains ignored.
# Run scripts/setup_acon.ps1 before selecting TRACEGRAPH_MANAGER=acon_official.
TRACEGRAPH_ACON_ROOT=vendor/acon-main
TRACEGRAPH_ACON_CONFIG=configs/acon_tau3.json
TRACEGRAPH_ACON_COMPRESSOR_MODEL=zai/glm-4.5-air
