# Model provider keys used by live τ³-bench runs. Set only the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# GLM / Z.AI (China BigModel endpoint). Never put a real key in this example.
ZAI_API_KEY=
ZAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
TRACEGRAPH_AGENT_MODEL=zai/glm-4.5-air
TRACEGRAPH_USER_MODEL=zai/glm-4.5-air

# TraceGraph live τ³ context-manager condition.
TRACEGRAPH_MANAGER=full_ours
TRACEGRAPH_BUDGET=2048
TRACEGRAPH_LAST_K=8
TRACEGRAPH_OUTPUT_DIR=outputs/tau3_live
