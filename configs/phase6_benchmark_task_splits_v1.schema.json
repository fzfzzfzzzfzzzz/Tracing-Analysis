{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第六阶段公开测试任务编号划分文件",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "splits"],
  "properties": {
    "schema_version": {"const": "phase6_benchmark_task_splits_v1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "splits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": false
}
